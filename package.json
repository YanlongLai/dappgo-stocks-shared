{
  "name": "dappgo-stocks-shared",
  "version": "0.4.2",
  "description": "Shared pure-TypeScript utilities and mobile logic for the DappGo app family.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "jest",
    "tsc": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./dappgo-products": "./src/dappgo-products.ts",
    "./verdict-label": "./src/verdict-label.ts",
    "./verdict-explain": "./src/verdict-explain.ts",
    "./days-until": "./src/days-until.ts",
    "./insider-direction": "./src/insider-direction.ts",
    "./sec-form-color": "./src/sec-form-color.ts",
    "./compute-ma": "./src/compute-ma.ts",
    "./sector-aggregate": "./src/sector-aggregate.ts",
    "./ticker-aggregate": "./src/ticker-aggregate.ts",
    "./ads/*": "./src/ads/*.ts",
    "./src/ads/*": "./src/ads/*.ts",
    "./mobile/*": "./src/mobile/*.ts",
    "./src/mobile/*": "./src/mobile/*.ts"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "~5.9.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "cacheDirectory": "<rootDir>/node_modules/.cache/jest",
    "maxWorkers": 2
  },
  "private": true,
  "license": "Proprietary"
}
